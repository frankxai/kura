{
  "name": "kura",
  "version": "0.2.0",
  "private": true,
  "description": "Kura — export your most precious writing. Local-first Chrome extension that captures conversations, prompts and AI-generated media from every major AI platform into an Obsidian-compatible vault on disk. No cloud. No tracking. Built by Arcanea, free for everyone.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "build": "tsc --noEmit && wxt build",
    "build:dev": "wxt build --mode development",
    "lint": "pnpm exec eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:extension": "pnpm build && pnpm exec playwright test",
    "test:bridge": "node --test tests/kura-sis-bridge.spec.mjs",
    "bridge:sis": "node scripts/kura-sis-bridge.mjs",
    "package:store": "wxt zip"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.37.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wxt": "^0.20.27"
  },
  "license": "MIT",
  "author": "FrankX <frank@arcanea.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankxai/arcanea-vault"
  },
  "keywords": [
    "chrome-extension",
    "obsidian",
    "second-brain",
    "ai-capture",
    "local-first",
    "chatgpt-export",
    "claude-export",
    "gemini-export",
    "grok-export",
    "deepseek-export",
    "perplexity-export",
    "knowledge-graph",
    "worldbuilding",
    "arcanea"
  ]
}
